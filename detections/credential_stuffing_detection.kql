// Credential Stuffing & Distributed Password Spraying Detection Rule
// Maps to MITRE ATT&CK T1110.03 & T1110.04

let timeframe = 1h;
let failureThreshold = 5;
let uniqueIpThreshold = 3;

SigninLogs
| where TimeGenerated > ago(timeframe)
| where ResultType != 0 // Filter for failed authentication attempts
| summarize 
    FailedAttempts = count(), 
    DistinctIPs = dcount(IPAddress), 
    SourceIPs = make_set(IPAddress, 10) 
    by UserPrincipalName
| where FailedAttempts >= failureThreshold 
  and DistinctIPs >= uniqueIpThreshold
| project 
    DetectTime = now(),
    UserPrincipalName,
    FailedAttempts,
    DistinctIPs,
    SourceIPs
| sort by FailedAttempts desc